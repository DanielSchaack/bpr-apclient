{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-x86-debug",
            "displayName": "Windows clang-cl x86 Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x86-windows",
                "CMAKE_MAKE_PROGRAM": "C:/Users/iolds/AppData/Local/Microsoft/WinGet/Packages/Ninja-build.Ninja_Microsoft.Winget.Source_8wekyb3d8bbwe/ninja.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-x86-release",
            "displayName": "Windows clang-cl x86 Release",
            "inherits": "windows-x86-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-x86-debug",
            "configurePreset": "windows-x86-debug"
        },
        {
            "name": "windows-x86-release",
            "configurePreset": "windows-x86-release"
        }
    ]
}